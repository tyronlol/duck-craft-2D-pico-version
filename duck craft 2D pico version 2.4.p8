pico-8 cartridge // http://www.pico-8.com
version 41
__lua__

-- player and other objects

player = {
  x = 64,
  y = 64,
  spr_id = 1,
  spd = 1
}

-- animation
anim_timer = 0
anim_frame = 61

blocks_x = {}
blocks_y = {}
blocks_id = {}

blocks_name = {
  "grass",
  "planks",
  "stone",
  "log",
  "leaves",
  "bricks",
  "dirt",
  "glass",
  "lake",
  "sand",
  "table",
  "chair",
  "torch",
  "brush",
  "flowers",
  "cup of water"
}

add(blocks_name, "destroy")
block_destroy_id = #blocks_name + 1


block_color = {
  3,
  15,
  6,
  4,
  11,
  8,
  4,
  7,
  12,
  15,
  4,
  4,
  9,
  11,
  11,
  12
}

add(block_color, 8)

block_id = 2


function _init()
end


function _update()
  local dx = 0
  local dy = 0

  -- move
  if btn(0) then
    dx -= player.spd
  end

  if btn(1) then
    dx += player.spd
  end

  if btn(2) then
    dy -= player.spd
  end

  if btn(3) then
    dy += player.spd
  end

  player.x += dx
  player.y += dy

  if player.x < 0 then
    player.x = 0
  end

  if player.x > 120 then
    player.x = 120
  end

  if player.y < 0 then
    player.y = 0
  end

  if player.y > 120 then
    player.y = 120
  end

  -- animation
    -- animation
  if dx != 0 or dy != 0 then
    anim_timer += 1

    if anim_timer >= 15 then
      anim_timer = 0

      if anim_frame == 61 then
        anim_frame = 62
      else
        anim_frame = 61
      end
    end

    player.spr_id = anim_frame
  else
    anim_timer = 0
    anim_frame = 61
    player.spr_id = 61
  end

  -- place
  if btnp(4) then
    sfx(2)

    local grid_x = (player.x \ 8) * 8
    local grid_y = (player.y \ 8) * 8

    local block_index = nil

    for i = 1, #blocks_x do
      if blocks_x[i] == grid_x
      and blocks_y[i] == grid_y then
        block_index = i
        break
      end
    end


    if block_id == block_destroy_id then

      if block_index != nil then
        sfx(4)

        deli(blocks_x, block_index)
        deli(blocks_y, block_index)
        deli(blocks_id, block_index)
      end


    else
      if block_index == nil then
        add(blocks_x, grid_x)
        add(blocks_y, grid_y)
        add(blocks_id, block_id)

      else
        blocks_id[block_index] = block_id
      end
    end
  end


  -- choose block
  if btnp(5) then
    sfx(1)

    block_id += 1

    if block_id > block_destroy_id then
      block_id = 2
    end
  end
end


function _draw()
  cls(0)

  print(
    blocks_name[block_id - 1],
    2,
    2,
    block_color[block_id - 1]
  )

  for i = 1, #blocks_x do
    spr(
      blocks_id[i],
      blocks_x[i],
      blocks_y[i]
    )
  end

  spr(
    player.spr_id,
    player.x,
    player.y
  )

  spr(
    63,
    (player.x \ 8) * 8,
    (player.y \ 8) * 8
  )
end

